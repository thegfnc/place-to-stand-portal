# Supply-chain cooldown: only resolve package versions published at least
# 7 days ago (verified on npm 11.19). Applies to install/update/outdated/audit fix;
# installs from package-lock.json are unaffected.
min-release-age=7

# Exempt so security releases land immediately. Each release exact-pins its
# companions (react-dom -> scheduler, next -> @next/env, @next/swc-*,
# @swc/helpers, styled-jsx), so those must be exempt too or the install fails.
min-release-age-exclude[]=react
min-release-age-exclude[]=react-dom
min-release-age-exclude[]=scheduler
min-release-age-exclude[]=@types/react
min-release-age-exclude[]=@types/react-dom
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=eslint-config-next
min-release-age-exclude[]=@swc/helpers
min-release-age-exclude[]=styled-jsx
min-release-age-exclude[]=@vercel/*
